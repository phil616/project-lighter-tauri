# Consistent source files on Windows and Linux
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Preserve upstream RST headings and placeholder files verbatim.
*.rst conflict-marker-size=32
native/vendor/qdarkstyle/**/.keep -whitespace

# Small source assets and screenshots stay in ordinary Git, without text conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Executables, libraries and release archives are generated by CI and ignored.
# This source repository does not track build outputs through Git LFS.
